entity = {
	name = "Kuat_Gladiator_main_entity"
	pdxmesh = "Gladiator_mesh"
	
	default_state = "idle"
	state = { name = "idle" state_time = 5
		event = { time = 0 node = "E_01" particle = "SG_01_3_0_cavelry_ship_exhaust_idle_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "E_02" particle = "SG_01_3_0_cavelry_ship_exhaust_idle_particle" trigger_once = yes keep_particle = yes }
	}
	state = { name = "moving" state_time = 5
		event = { time = 0 node = "E_01" particle = "SG_01_3_0_cavelry_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "E_02" particle = "SG_01_3_0_cavelry_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
	}
	state = { name = "death"  state_time = 5 looping = no 
		event = { time = 2.5 node = "target_locator_1" particle = "kuat_s_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ship_explosion" } }
		event = { time = 3.5 node = "target_locator_2" particle = "kuat_s_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ship_explosion" } }
		event = { time = 5.5 node = "target_locator_3" particle = "kuat_s_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ship_explosion" } }
		event = { time = 7.5 node = "target_locator_4" particle = "kuat_s_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ship_explosion" } }
		event = { time = 9.5 node = "target_locator_5" particle = "kuat_s_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ship_explosion" } }
		event = { time = 9.5 node = "target_locator_6" particle = "kuat_s_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ship_explosion" } }
		event = { time = 9.5 node = "target_locator_7" particle = "kuat_s_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ship_explosion" } }
		event = { time = 9.5 node = "target_locator_8" particle = "kuat_s_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "ship_explosion" } }
		event = { time = 12.5 node = "root" particle = "kuat_sd_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "amb_titan_ship_death" } }
	}
	game_data = { size = 15 }
}