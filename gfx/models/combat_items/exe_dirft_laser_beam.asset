#	敌无人机


###	敌无人机	############################################################
#	枪口
entity = {
	name = "exe_dirft_laser_beam_green_MUZZLE_entity"
	pdxmesh = "locator_mesh"
	
	default_state = "idle"
	state = { name = "idle" state_time = 1.5 looping = no
		event = { time = 0.0 particle = "exe_dirft_laser_beam_green_MUZZLE"	sound = { soundeffect = titan_laser_fire_01 } }
		event = { trigger_once = yes sound = { soundeffect = distance_titan_laser_fire_01 } }
	}
}
#	命中	flare盖爆炸
entity = {
	name = "exe_dirft_laser_beam_green_HIT_entity"
	pdxmesh = "locator_mesh"
	locator = { name = "fx"		position = { 0 0 0.19 } }
	locator = { name = "exp"	position = { 0 0 0.19 } }
	cull_radius = 1.0
	state = { name = "explode_med_hp" state_time = 1.5 looping = no
		event = { time = 0.035	node = "fx"	particle = "exe_dirft_laser_beam_green_HIT" sound = { soundeffect = titan_laser_hit } }
	}
	default_state = "explode_med_hp"
}
#	护盾
entity = {
	name = "exe_dirft_laser_beam_green_SHIELD_entity"
	pdxmesh = "locator_mesh"
	cull_radius = 1.0
	state = { name = "explode_med_hp" state_time = 1.5 looping = no
		event = { time = 0.035 particle = "exe_dirft_laser_beam_green_SHIELD" sound = { soundeffect = titan_laser_hit } }
	}
	default_state = "explode_med_hp"
}
#	冷却
entity = {
	name = "exe_dirft_laser_beam_green_WINDUP_entity"
	pdxmesh = "locator_mesh"

	default_state = "attack"
	state = { name = "attack" state_time = 1.5 looping = no
		event = { time = 0.0 particle = "exe_dirft_laser_beam_green_WINDUP"	sound = { soundeffect = titan_laser_windup_01 } }
	}
}

